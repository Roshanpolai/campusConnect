PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAIN=silicon.ac.in

# Cloudinary — used for ALL uploaded media: profile photos, event banners,
# marketplace/lost&found photos, and also documents (notes, PYQs, timetable
# PDFs, resumes, certificates, zips) as Cloudinary "raw" assets. Video is
# never accepted anywhere in this app.
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — required only for real password-reset emails to be sent.
# Without these, forgot-password still works: the reset link is logged to the
# server console and returned as `devResetToken` in the API response.
# Example values for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<app password, not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusConnect <no-reply@silicon.ac.in>"

# Bootstrap super admin (used by `npm run seed`, see README)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_STUDENT_ID=
ADMIN_DEPARTMENT=
